# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design tooling scratch
/.playwright-mcp/
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/legacy/
/.impeccable/questions/
/.impeccable/hook.cache.json

# local source material for scripts/ (not part of the site)
/PROJECTS/
/scripts/fonts/

# local handoff notes for the next chat (not for the public repo)
/HANDOFF.md

# python bytecode
__pycache__/
